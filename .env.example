# ============================================================
# وثبة waathba.com — متغيرات البيئة
# ============================================================

# --- Supabase (للإنتاج) -------------------------------------
# اتركها فارغة للوضع التجريبي المحلي (قاعدة بيانات SQLite داخلية)
#
# رابط المشروع فقط — مثال: https://abcdxyz.supabase.co
# ⚠️ لا تلصق رابط REST من لوحة Supabase (https://abcdxyz.supabase.co/rest/v1)،
#    ولا تضع علامات تنصيص ولا مسافات أو أسطرًا جديدة:
#    supabase-js يضيف /rest/v1 بنفسه، فأي مسار ملصوق يجعل الطلب
#    /rest/v1/rest/v1/<table> ويرد PostgREST بالخطأ:
#    PGRST125 — Invalid path specified in request URL
# (التطبيق يصحّح هذه الأخطاء تلقائيًا ويطبع تحذيرًا في السجلات — لكن القيمة النظيفة أفضل)
NEXT_PUBLIC_SUPABASE_URL=
# المفاتيح الحديثة الموصى بها (Settings → API Keys)
# انسخها كما هي بلا أسطر جديدة أو مسافات إضافية (تُنظَّف تلقائيًا أيضًا)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# مفتاح سري للخادم فقط — لا تضعه أبدًا في متغير NEXT_PUBLIC
SUPABASE_SECRET_KEY=

# بدائل Legacy مدعومة للتوافق؛ لا تملأها إذا استخدمت المفاتيح الحديثة أعلاه
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- الإعدادات العامة ----------------------------------------
# الدومين الرئيسي للمنصة (يُستخدم لتوليد روابط المتاجر)
NEXT_PUBLIC_MAIN_DOMAIN=waathba.com

# رابط موقع المطور الذي يظهر أسفل كل متجر:
# "تطوير: waathba.com" — يمكن تغييره أيضًا من لوحة الإدارة → الإعدادات
DEVELOPER_URL=https://waathba.com

# --- بيانات العرض التجريبي (الوضع المحلي فقط) -----------------
# حساب المالك (أنت) في الوضع التجريبي
LOCAL_OWNER_EMAIL=owner@waathba.com
LOCAL_OWNER_PASSWORD=Wathba#2026
