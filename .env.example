# ============================================================
# وثبة WathbaStore — متغيرات البيئة
# ============================================================

# --- Supabase (للإنتاج) -------------------------------------
# اتركها فارغة للوضع التجريبي المحلي (قاعدة بيانات SQLite داخلية)
NEXT_PUBLIC_SUPABASE_URL=
# المفاتيح الحديثة الموصى بها (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# مفتاح سري للخادم فقط — لا تضعه أبدًا في متغير NEXT_PUBLIC
SUPABASE_SECRET_KEY=

# بدائل Legacy مدعومة للتوافق؛ لا تملأها إذا استخدمت المفاتيح الحديثة أعلاه
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- الإعدادات العامة ----------------------------------------
# الدومين الرئيسي للمنصة (يُستخدم لتوليد روابط المتاجر)
NEXT_PUBLIC_MAIN_DOMAIN=wathbastore.com

# رابط موقع المطور الذي يظهر أسفل كل متجر:
# "تطوير: WathbaStore" — يمكن تغييره أيضًا من لوحة الإدارة → الإعدادات
DEVELOPER_URL=https://wathbastore.com

# --- بيانات العرض التجريبي (الوضع المحلي فقط) -----------------
# حساب المالك (أنت) في الوضع التجريبي
LOCAL_OWNER_EMAIL=owner@wathbastore.com
LOCAL_OWNER_PASSWORD=Wathba#2026
