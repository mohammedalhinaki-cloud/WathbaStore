{
  // ============================================================
  // معين maaoun.com — إعداد Cloudflare (OpenNext + Workers)
  // عبر الأدوات الرسمية: opennextjs-cloudflare build / deploy
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  // اسم عامل Cloudflare الحالي. لا تغيّره إلى maaoun: النشر التالي سينشئ
  // عاملًا جديدًا بدل تحديث العامل المنشور. إعادة التسمية يدوية من اللوحة فقط.
  "name": "waathba",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    // يتيح واجهات Node.js (node:sqlite, node:crypto, ...) وقت التشغيل
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // ملاحظة حول النطاق العرضي (Wildcard) تحت *.maaoun.com:
  // أضِف النطاقات من لوحة Cloudflare → Workers & Pages → مشروعك → Settings
  // → Domains & Routes (Custom Domains): maaoun.com وwww.maaoun.com
  // وكل نطاق فرعي لمتجر (rshaf.maaoun.com ...)، أو استخدم Worker مستقلا
  // يمرر x-forwarded-host لمطابقة أي نطاق فرعي (انظر docs/DEPLOY_CLOUDFLARE_AR.md).
}
